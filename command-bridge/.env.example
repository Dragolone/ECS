## HTTP 服务监听地址
HTTP_HOST=0.0.0.0
HTTP_PORT=8090

## EMQX 连接信息
MQTT_HOST=43.139.45.139
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=

## 当前测试阶段的命令前缀
MQTT_BASE_PREFIX=01_test

## 命令桥鉴权 Header: x-command-token
# 必须替换：每个令牌用 openssl rand -hex 32 单独生成，不要提交真实值
COMMAND_TOKEN=replace-with-random-command-token

## publish 等待确认超时（秒，可选）
MQTT_PUBLISH_TIMEOUT_SECONDS=3
